{
    "name": "tongflow",
    "version": "0.1.0",
    "description": "TongFlow workflow core: ABI, node registry, connection validation, workflow exporter, headless canvas model and agent graph tools.",
    "author": "tong-io",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/tong-io/tongflow",
        "directory": "packages/tongflow"
    },
    "homepage": "https://github.com/tong-io/tongflow#readme",
    "keywords": [
        "tongflow",
        "workflow",
        "aigc",
        "multimodal",
        "agent"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json",
        "./abi": "./abi/tongflow.abi.json"
    },
    "files": [
        "dist",
        "abi",
        "README.md"
    ],
    "scripts": {
        "gen:abi": "tsx scripts/gen-abi-types.ts",
        "build": "tsdown",
        "test": "vitest run",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@types/json-schema": "7.0.15",
        "json-schema-to-ts": "3.1.1",
        "zod": "4.1.8"
    },
    "peerDependencies": {
        "@xyflow/react": "^12"
    },
    "peerDependenciesMeta": {
        "@xyflow/react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "20.19.13",
        "@xyflow/react": "12.9.0",
        "tsdown": "0.22.14",
        "tsx": "4.20.5",
        "typescript": "5",
        "vitest": "4.1.5"
    }
}
